# Copy to .env.local for local dev. The defaults below match backend/.env.example.

# The backend API, read on the server only (getContent, and the dev rewrites in next.config.ts)
API_URL=http://localhost:8000/api/v1

# Shared with the backend (REVALIDATE_SECRET there): lets it expire the content cache after a CMS save
REVALIDATE_SECRET=
